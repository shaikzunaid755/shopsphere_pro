# copy this file to .env and fill in your own values - never commit .env
APP_NAME=ShopSphere Pro
DEBUG=True

# MySQL
DB_USER=root
DB_PASSWORD=Zunnu2001
DB_HOST=localhost
DB_PORT=3306
DB_NAME=shopsphere_db
# optional - full url, wins over the DB_* values (tests use sqlite through this)
DATABASE_URL=

# JWT - use a long random string, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# payments - leave Stripe empty to use the sandbox gateway, only ever use sk_test_ keys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SANDBOX_WEBHOOK_SECRET=local-sandbox-secret
CURRENCY=inr

# email - empty SMTP_HOST means emails are only written to the log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@shopsphere.local

UPLOAD_DIR=uploads
EXPORT_DIR=exports
MAX_UPLOAD_MB=5
FREE_SHIPPING_ABOVE=999
COD_MAX_AMOUNT=10000
ENABLE_SCHEDULER=False
